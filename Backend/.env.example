# Copie este arquivo para .env e preencha com a sua chave.
# Sem a chave, o jogo ainda roda: create_character cai no prólogo de
# fallback (api.py:48) e /chat responde com narrativa vazia.
#
# Chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=

# Opcionais (Etapa 4) — têm um valor padrão sensato em app/infra/settings.py,
# só precisa preencher para sobrescrever.
# MODEL_NAME=openai/gpt-oss-120b
# MODELOS_FALLBACK=["openai/gpt-oss-20b","qwen/qwen3.6-27b"]
# AGENT_MAX_PASSOS=6
