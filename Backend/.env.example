# Copie este arquivo para .env e preencha com a sua chave.
# Sem a chave, o jogo ainda roda: create_character cai no prólogo de
# fallback (api.py:48) e /chat responde com narrativa vazia.
#
# Chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=

# Etapa 14 (ADR-0023/ADR-0024) — segundo provedor na cadeia de fallback de
# chat, e o único provedor dos embeddings (app/infra/embeddings.py). Sem
# esta chave: cadeia_llm pula todo elo "gemini:...", e embeddings degradam
# para busca só léxica (BM25) — o jogo continua rodando, memória e RAG só
# perdem o sinal denso.
# Chave gratuita (sem cartão) em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionais (ADR-0038) — têm um valor padrão sensato em
# app/infra/settings.py, só precisa preencher para sobrescrever. Há uma
# lista de modelos por papel: volume (turno de jogo), destaque (prólogo,
# morte, desfechos) e fundo (resumo da memória). Cada item é
# "provedor:modelo" ("groq" ou "gemini"); precisa de JSON estrito
# (colchetes/aspas) por vir de variável de ambiente.
# CADEIA_VOLUME=["gemini:gemini-3.5-flash-lite","gemini:gemini-3.5-flash"]
# CADEIA_DESTAQUE=["gemini:gemini-3.5-flash","gemini:gemini-3.5-flash-lite"]
# CADEIA_FUNDO=["gemini:gemini-3.1-flash-lite","gemini:gemini-3.5-flash-lite"]
# Tempo limite por chamada (segundos) e quanto o Gemini "pensa", por papel.
# TIMEOUTS_IA={"volume":25,"destaque":50,"fundo":30}
# PRAZOS_IA={"volume":45,"destaque":90,"fundo":60}
# TIMEOUTS_MODELO={"gemini-3.5-flash-lite":22,"gemini-3.1-flash-lite":22}
# Limites do plano por modelo, [por minuto, por dia] (ver ai.dev/rate-limit).
# LIMITES_IA={"gemini-3.5-flash-lite":[15,500],"gemini-3.5-flash":[5,20]}
# ESFORCO_RACIOCINIO={"volume":"low"}
# MODELO_BARATO=gemini:gemini-3.5-flash-lite
# AGENT_MAX_PASSOS=6

# Etapa 6 (evals/) — as mesmas chaves acima já bastam para rodar
# `uv run python -m evals.run_eval` localmente. O job `avaliacao` do CI
# (.github/workflows/ci.yml, disparo manual via workflow_dispatch) precisa
# das MESMAS chaves configuradas como secret do repositório no GitHub
# (Settings → Secrets and variables → Actions → GROQ_API_KEY,
# GEMINI_API_KEY) — isso não vem deste arquivo, é configuração separada do
# GitHub.

# Etapa 8 (login por senha + Google opcional, ADR-0014).
# Assina o cookie de sessão — troque em qualquer ambiente que não seja
# a sua própria máquina (mudar isto derruba todas as sessões ativas).
SESSION_SECRET=dev-secret-troque-em-producao

# URL do Frontend rodando localmente — usada para redirecionar de volta
# depois do login com Google.
# FRONTEND_URL=http://localhost:5173

# Opcionais — sem os dois, o botão "Entrar com Google" fica desabilitado
# no front (GET /auth/opcoes), mas login por e-mail/senha funciona igual.
# Criar em https://console.cloud.google.com/apis/credentials — tipo "Web
# application", com http://localhost:8000/auth/google/callback cadastrado
# como URI de redirecionamento autorizado.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
