# Copie este arquivo para .env e preencha com a sua chave.
# Sem a chave, o jogo ainda roda: create_character cai no prólogo de
# fallback (api.py:48) e /chat responde com narrativa vazia.
#
# Chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=

# Opcionais (Etapa 4) — têm um valor padrão sensato em app/infra/settings.py,
# só precisa preencher para sobrescrever.
# MODEL_NAME=openai/gpt-oss-120b
# MODELOS_FALLBACK=["openai/gpt-oss-20b","qwen/qwen3.6-27b"]
# AGENT_MAX_PASSOS=6

# Etapa 6 (evals/) — a mesma GROQ_API_KEY acima já basta para rodar
# `uv run python -m evals.run_eval` localmente. O job `avaliacao` do CI
# (.github/workflows/ci.yml, disparo manual via workflow_dispatch) precisa
# da MESMA chave configurada como secret do repositório no GitHub
# (Settings → Secrets and variables → Actions → GROQ_API_KEY) — isso não
# vem deste arquivo, é uma configuração separada do GitHub.
