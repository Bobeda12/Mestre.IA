# Copie para .env (ignorado pelo git) e ajuste se o backend não estiver
# rodando em localhost:8000.
#
# Precisa ser "localhost", não "127.0.0.1": desde a Etapa 8 a sessão é um
# cookie SameSite=Lax, e pra fins de SameSite os dois são sites diferentes
# (ver lib/api.ts) — misturar os dois faz o navegador aceitar o login mas
# nunca devolver o cookie depois.
VITE_API_URL=http://localhost:8000
